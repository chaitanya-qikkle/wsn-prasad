# Supabase service credentials (privileged writes from backend)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key

SECRET_KEY=change-me-in-production-trustchain-wsn-secret

# Framework tuning
TRUST_THRESHOLD=0.40
BLOCK_DIFFICULTY=2
